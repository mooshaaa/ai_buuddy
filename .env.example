# stub: без модели, работает всегда. openai_compat: любая OpenAI-совместимая модель.
LLM_PROVIDER=stub

# Пример для Groq (скопируйте в .env и вставьте свой ключ; .env в git не попадает):
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_FALLBACK_MODEL=openai/gpt-oss-20b
# LLM_API_KEY=
# LLM_TIMEOUT=15

# DEBUG=1: строка отладки под ответами, панель лога и /api/debug/events. Для сдачи ставьте 0.
# DEBUG=1
